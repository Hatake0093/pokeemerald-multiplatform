RivalsHouse_1F_Text_OhYoureTheNewNeighbor:
	.string "Oh, hola. ¿Y tú eres?\p"
	.string "… … … … … … … … …\n"
	.string "… … … … … … … … …\p"
	.string "Oh, eres {PLAYER}, ¡nuestro nuevo\n"
	.string "vecino! ¡Hola!\p"
	.string "Tenemos {STR_VAR_1} de tu edad.\p"
	.string "Le emocionaba hacer un nuevo\n"
	.string "amigo.\p"
	.string "Creo que está arriba.$"

RivalsHouse_1F_Text_LikeChildLikeFather:
	.string "De tal palo, tal astilla.\p"
	.string "Mi esposo está tan loco por los\n"
	.string "POKéMON como {RIVAL}.\p"
	.string "Si no está en su LAB, seguro anda\n"
	.string "revolviendo la hierba.$"

RivalsHouse_1F_Text_TooBusyToNoticeVisit:
	.string "¡Ese {RIVAL}!\p"
	.string "Debe estar tan ocupado con sus\n"
	.string "POKéMON que no notó tu visita,\l"
	.string "{PLAYER}.$"

RivalsHouse_1F_Text_WentOutToRoute103:
	.string "Oh, {RIVAL} salió a la ROUTE 103\n"
	.string "hace un momento.\p"
	.string "Igual que su padre, no puede\n"
	.string "quedarse quieto en casa.$"

RivalsHouse_1F_Text_ShouldGoHomeEverySoOften:
	.string "Me parece genial viajar con\n"
	.string "POKéMON.\p"
	.string "Pero deberías volver a casa de vez\n"
	.string "en cuando para que tu madre sepa\l"
	.string "que estás bien.\p"
	.string "Quizá no lo diga, pero seguro se\n"
	.string "preocupa por ti, {PLAYER}.$"

RivalsHouse_1F_Text_MayWhoAreYou:
	.string "¿Eh? ¿Quién eres?\p"
	.string "… … … … … … … …\n"
	.string "… … … … … … … …\p"
	.string "Ah, eres {PLAYER}.\n"
	.string "Soy MAY. ¡Mucho gusto!\p"
	.string "Sueño con ser amiga de los POKéMON\n"
	.string "de todo el mundo.\p"
	.string "Mi papá, el PROF. ABEDUL, me habló\n"
	.string "de ti. ¡Espero que seamos amigos!\p"
	.string "¡Ay, no! Debía ayudar a papá a\n"
	.string "capturar POKéMON.\p"
	.string "¡{PLAYER}, nos vemos luego!$"

RivalsHouse_1F_Text_BrendanWhoAreYou:
	.string "¡Oye! ¿Quién eres?\p"
	.string "Ah, eres {PLAYER}, ¿verdad?\n"
	.string "No sabía que eras chica.\p"
	.string "Mi papá, el PROF. ABEDUL, dijo que\n"
	.string "el vecino era hijo de un LÍDER DE\l"
	.string "GIMNASIO y supuse que sería chico.\p"
	.string "Me llamo BRENDAN. ¡Hola, vecina!\p"
	.string "¿No tienes un POKéMON? Podría\n"
	.string "capturarte uno, pero debo ayudar\l"
	.string "a mi papá. Otro día, ¿sí?$"

RivalsHouse_1F_Text_DoYouHavePokemon:
	.string "¡Hola, vecino!\p"
	.string "¿Ya tienes tu propio POKéMON?$"
